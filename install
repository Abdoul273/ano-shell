    ano-shell-theme.path \
    ano-shell-login-sync.path \
    ano-shell-watch.timer \
    bt-audio-autoswitch.service \
    ydotool.service \
    pipewire.socket \
    pipewire-pulse.socket \
    wireplumber.service 2>/dev/null || true
ok "$(t "Unités systemd utilisateur activées" "User systemd units enabled")"

# On fresh Arch ("no desktop"), enable core system services + SDDM + keymap + Fish
if (( SYSTEM_SETUP )); then
    for svc in NetworkManager bluetooth power-profiles-daemon; do
        if systemctl list-unit-files "${svc}.service" >/dev/null 2>&1; then
            run sudo systemctl enable "$svc" 2>/dev/null || true
        fi
    done
    if systemctl list-unit-files sddm.service >/dev/null 2>&1; then
        run sudo systemctl enable --force sddm 2>/dev/null || true
    fi
    if getent group input >/dev/null 2>&1 && ! id -nG "$USER" | grep -qw input; then
        run sudo usermod -aG input "$USER" 2>/dev/null || true
    fi
    if [[ ! -f /etc/X11/xorg.conf.d/00-keyboard.conf ]] && command -v localectl >/dev/null 2>&1; then
        run sudo localectl --no-convert set-x11-keymap "$KB_LAYOUT" 2>/dev/null || true
    fi
    ok "$(t \
        "Services système activés (SDDM, NetworkManager, Bluetooth, Power Profiles)" \
        "System services enabled (SDDM, NetworkManager, Bluetooth, Power Profiles)")"

    if command -v fish >/dev/null 2>&1 && [[ "$(getent passwd "$USER" | cut -d: -f7)" != "$(command -v fish)" ]]; then
        if ask "$(t "Définir fish comme shell par défaut ?" "Set fish as your default shell?")" y; then
            run chsh -s "$(command -v fish)" || warn "$(t \
                "chsh ignoré (lancez : chsh -s /usr/bin/fish)" \
                "chsh skipped (run: chsh -s /usr/bin/fish)")"
        fi
    fi
fi

