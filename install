if [[ ! -f "$HOME/.config/ano-shell/hypr/colors.conf" ]]; then
    run touch "$HOME/.config/ano-shell/hypr/colors.conf"
fi

KB_LAYOUT="$(detect_kb_layout)"
if (( STANDALONE_HYPR )) || [[ ! -f "$HOME/.config/hypr/hyprland.conf" && ! -f "$HOME/.config/hypr/hyprland.lua" ]]; then
    install_item "config/hypr/standalone/hyprland.conf" "$HOME/.config/hypr/hyprland.conf"
    if (( ! DRY_RUN )) && [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
        sed -i "s/^    kb_layout = .*/    kb_layout = ${KB_LAYOUT}/" "$HOME/.config/hypr/hyprland.conf"
    fi
    ok "$(t \
        "Configuration Hyprland autonome installée (~/.config/hypr/hyprland.conf, clavier : $KB_LAYOUT)" \
        "Standalone Hyprland config installed (~/.config/hypr/hyprland.conf, keyboard: $KB_LAYOUT)")"
elif [[ -f "$HOME/.config/hypr/hyprland.conf" ]]; then
    if ! grep -q "ano-shell/hypr/shell.conf" "$HOME/.config/hypr/hyprland.conf"; then
        backup_path "$HOME/.config/hypr/hyprland.conf"
        if (( ! DRY_RUN )); then
            printf '\n# Ano Shell Liquid Glass\nsource = ~/.config/ano-shell/hypr/shell.conf\n' >> "$HOME/.config/hypr/hyprland.conf"
        fi
        ok "$(t "Ligne source ajoutée à ~/.config/hypr/hyprland.conf" "Source line added to ~/.config/hypr/hyprland.conf")"
    else
        ok "$(t "source ano-shell/hypr/shell.conf déjà présente dans hyprland.conf" "source ano-shell/hypr/shell.conf already present in hyprland.conf")"
    fi
else
    warn "$(t \
        "Config Hyprland Lua détectée : lancez ano-shell côte à côte avec 'setsid -f ano-shell shell -d'." \
        "Hyprland Lua config detected: start ano-shell side-by-side with 'setsid -f ano-shell shell -d'.")"
fi

