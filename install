PATH=$HOME/.local/bin:\${PATH}
XDG_PICTURES_DIR=$PICTURES_DIR
XDG_VIDEOS_DIR=$VIDEOS_DIR
EOF
    if [[ ! -f "$HOME/.bash_profile" ]] || ! grep -q '\.local/bin' "$HOME/.bash_profile" 2>/dev/null; then
        printf '\n# Ano Shell PATH\n[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"\n' >> "$HOME/.bash_profile"
    fi
fi

