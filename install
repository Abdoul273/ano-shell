#!/usr/bin/env bash
# ============================================================================
#  Ano Shell — Complete 1-click installer (Arch "no desktop", Hyprland, or AUR)
#  https://github.com/Abdoul273/ano-shell
#
#  Usage:
#    ./install [--full] [--yes] [--lang en|fr|auto] [--no-deps] [--no-build]
#              [--rebuild] [--profile ultra|eco|auto] [--standalone-hypr]
#              [--with-plymouth] [--migrate-caelestia] [--dry-run] [--help]
# ============================================================================

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="$HOME/.local/share/ano-shell/backups/$(date +%Y%m%d-%H%M%S)"
MANIFEST="$BACKUP_DIR/manifest"

FULL=0
EXPLICIT_FULL=0
YES=0
NO_DEPS=0
NO_BUILD=0
REBUILD=0
STANDALONE_HYPR=0
WITH_PLYMOUTH=0
MIGRATE_CAELESTIA=0
DRY_RUN=0
PERF_PROFILE=""
LANG_ARG=""

# Detect system / saved language (defaults to English unless French locale is active)
detect_ui_lang() {
    local saved=""
    if [[ -f "$HOME/.config/ano-shell/lang.json" ]]; then
        saved="$(sed -n 's/.*"lang"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HOME/.config/ano-shell/lang.json" | head -n1 || true)"
    fi
    local raw="${ANOSHELL_LANG:-}"
    if [[ -z "$raw" && ( "$saved" == "fr" || "$saved" == "en" ) ]]; then
        raw="$saved"
    fi
    if [[ -z "$raw" ]]; then
        raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
    fi
    case "${raw,,}" in
        fr*) echo "fr" ;;
        *)   echo "en" ;;
    esac
}

UI_LANG="$(detect_ui_lang)"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full) FULL=1; EXPLICIT_FULL=1 ;;
        --yes|-y) YES=1 ;;
        --lang)
            shift
            LANG_ARG="${1:-}"
            [[ "$LANG_ARG" =~ ^(fr|en|auto)$ ]] || { echo "Invalid language / Langue invalide : $LANG_ARG (en | fr | auto)" >&2; exit 1; }
            ;;
        --lang=*)
            LANG_ARG="${1#*=}"
            [[ "$LANG_ARG" =~ ^(fr|en|auto)$ ]] || { echo "Invalid language / Langue invalide : $LANG_ARG (en | fr | auto)" >&2; exit 1; }
            ;;
        --no-deps) NO_DEPS=1 ;;
        --no-build) NO_BUILD=1 ;;
        --rebuild) REBUILD=1 ;;
        --profile)
            shift
            PERF_PROFILE="${1:-}"
            [[ "$PERF_PROFILE" =~ ^(ultra|eco|auto)$ ]] || { echo "Invalid profile / Profil invalide : $PERF_PROFILE (ultra | eco | auto)" >&2; exit 1; }
            ;;
        --profile=*)
            PERF_PROFILE="${1#*=}"
            [[ "$PERF_PROFILE" =~ ^(ultra|eco|auto)$ ]] || { echo "Invalid profile / Profil invalide : $PERF_PROFILE (ultra | eco | auto)" >&2; exit 1; }
            ;;
        --standalone-hypr) STANDALONE_HYPR=1 ;;
        --with-plymouth) WITH_PLYMOUTH=1 ;;
        --migrate-caelestia) MIGRATE_CAELESTIA=1 ;;
        --dry-run) DRY_RUN=1 ;;
        --help|-h)
            sed -n '2,10p' "$0"
            exit 0
            ;;
        *)
            echo "Unknown option / Option inconnue : $1 (--help)" >&2
            exit 1
            ;;
    esac
    shift
done

if [[ "$LANG_ARG" == "fr" || "$LANG_ARG" == "en" ]]; then
    UI_LANG="$LANG_ARG"
fi

# Bilingual helper: t "texte français" "English text"
t() {
    if [[ "$UI_LANG" == "fr" ]]; then
        printf '%s' "$1"
    else
        printf '%s' "$2"
    fi
}

B=$'\033[1m' G=$'\033[32m' Y=$'\033[33m' C=$'\033[36m' R=$'\033[0m'
step() { printf "\n${B}${C}==> %s${R}\n" "$*"; }
ok()   { printf "  ${G}✓${R} %s\n" "$*"; }
warn() { printf "  ${Y}!${R} %s\n" "$*"; }

run() {
    if (( DRY_RUN )); then
        printf "  [dry-run] %s\n" "$*"
    else
        "$@"
    fi
}

ask() {
    local prompt="$1" default="${2:-y}" reply=""
    # Normalize French "o" default to "y"
    [[ "$default" == "o" ]] && default="y"
    if (( YES || DRY_RUN )); then
        [[ "$default" == "y" ]]
        return
    fi
    local hint="[Y/n]"
    if [[ "$UI_LANG" == "fr" ]]; then
        [[ "$default" == "y" ]] && hint="[O/n]" || hint="[o/N]"
    else
        [[ "$default" == "y" ]] && hint="[Y/n]" || hint="[y/N]"
    fi
    read -r -p "  $prompt $hint " reply || true
    if [[ "$default" == "y" ]]; then
        [[ ! "$reply" =~ ^[Nn] ]]
    else
        [[ "$reply" =~ ^[OoYy] ]]
    fi
}

backup_path() {
    local dst="$1"
    if [[ -e "$dst" || -L "$dst" ]]; then
        local rel="${dst#"$HOME/"}"
        if (( DRY_RUN )); then
            printf "  [dry-run] %s %s\n" "$(t "sauvegarde" "backup")" "$dst"
            return
        fi
        mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
        cp -a "$dst" "$BACKUP_DIR/$rel"
        printf "%s\n" "$dst" >> "$MANIFEST"
    fi
}

install_path() {
    local src="$1" dst="$2" label="$3"
    backup_path "$dst"
    if (( DRY_RUN )); then
        printf "  [dry-run] %s %s -> %s\n" "$(t "installe" "install")" "$label" "$dst"
        return
    fi
    mkdir -p "$(dirname "$dst")"
    rm -rf "$dst"
    cp -a "$src" "$dst"
}

install_item() {
    install_path "$ROOT/$1" "$2" "$1"
}

# Interactive language selection when running ./install directly on a TTY (no --lang, no --yes)
choose_language() {
    if [[ -n "$LANG_ARG" ]]; then
        return
    fi
    if (( YES || DRY_RUN )) || [[ ! -t 0 ]]; then
        LANG_ARG="auto"
        return
    fi
    local def=1
    [[ "$UI_LANG" == "fr" ]] && def=2
    printf "\n  Ano Shell — Language / Langue :\n"
    printf "    ${B}1)${R} English%s\n" "$([[ $def -eq 1 ]] && echo ' (default)')"
    printf "    ${B}2)${R} Français%s\n" "$([[ $def -eq 2 ]] && echo ' (par défaut)')"
    local ans=""
    read -r -p "  Choice / Choix [${def}]: " ans || true
    case "${ans:-$def}" in
        2|fr|FR|f|F) UI_LANG="fr"; LANG_ARG="fr" ;;
        *)           UI_LANG="en"; LANG_ARG="en" ;;
    esac
}

# Detect AUR system package installation (/usr/share/ano-shell)
FROM_SYSTEM_PKG=0
if [[ "$ROOT" == "/usr/share/ano-shell" && ! -d "$ROOT/shell" ]]; then
    FROM_SYSTEM_PKG=1
    if (( ! EXPLICIT_FULL )); then
        NO_DEPS=1
        NO_BUILD=1
    fi
fi

# Auto-detect fresh Arch Linux ("no desktop")
if (( ! NO_DEPS )) && { ! command -v Hyprland >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; }; then
    FULL=1
fi
# Even from AUR package, enable system services (SDDM, NetworkManager, Bluetooth) if no Hyprland config exists yet
SYSTEM_SETUP=$FULL
if (( FROM_SYSTEM_PKG )) && [[ ! -f "$HOME/.config/hypr/hyprland.conf" && ! -f "$HOME/.config/hypr/hyprland.lua" ]]; then
    SYSTEM_SETUP=1
fi

PACMAN_FLAGS=(--needed)
(( YES )) && PACMAN_FLAGS+=(--noconfirm)

install_system_packages() {
    step "$(t \
        "Installation des paquets Arch Linux officiels (Hyprland, Wayland, audio, applis)" \
        "Installing official Arch Linux packages (Hyprland, Wayland, audio, apps)")"
    run sudo pacman -Sy --needed --noconfirm archlinux-keyring 2>/dev/null || true

    local pkgs=(
        # Base tools (when ./install --full runs without bootstrap.sh)
        git base-devel
        # Wayland / Hyprland desktop + portals + session
        hyprland xdg-desktop-portal xdg-desktop-portal-hyprland xdg-desktop-portal-gtk
        polkit-gnome gnome-keyring sddm accountsservice xdg-user-dirs
        # Audio, Bluetooth, Network, Power, Sensors
        pipewire pipewire-pulse pipewire-alsa wireplumber
        bluez bluez-utils networkmanager upower
        brightnessctl ddcutil lm_sensors fftw libqalculate libpipewire
        # Qt6 & build tools for native AnoShell.* plugins
        cmake ninja pkgconf qt6-base qt6-declarative qt6-wayland qt6-svg
        qt6-imageformats qt6-multimedia qt6-multimedia-ffmpeg qt6-quick3d qt6-shadertools
        # Complete desktop & terminal suite (Nautilus, Kitty, Fastfetch, Fish, Starship, Onde CLI)
        nautilus sushi kitty fastfetch fish starship eza zoxide btop adw-gtk-theme papirus-icon-theme
        firefox pwvucontrol hyprpicker hyprsunset mpv ffmpeg yt-dlp sound-theme-freedesktop
        # Wayland, GTK4 & Python tools (ano-shell + bin/ + onde-cli)
        python python-pip python-setuptools python-wheel python-gobject gtk4 python-pillow python-rich python-mutagen
        python-numpy python-scipy python-flask
        grim slurp wl-clipboard cliphist swappy wtype ydotool libnotify dconf jq psmisc libxml2 fd
        # Fonts
        ttf-jetbrains-mono-nerd ttf-cascadia-code-nerd noto-fonts noto-fonts-emoji
    )

    # Avoid pacman conflict if tuned-ppd or tlp is already installed (CachyOS / EndeavourOS)
    if ! pacman -Q tuned-ppd >/dev/null 2>&1 && ! pacman -Q tlp >/dev/null 2>&1; then
        pkgs+=(power-profiles-daemon)
    fi

    # Packages available directly in official repos (extra / derivatives)
    if ! command -v qs >/dev/null 2>&1 && pacman -Si quickshell >/dev/null 2>&1; then
        pkgs+=(quickshell)
    fi
    for opt_repo in gpu-screen-recorder ttf-material-symbols-variable python-webrtcvad python-google-genai; do
        if pacman -Si "$opt_repo" >/dev/null 2>&1; then
            pkgs+=("$opt_repo")
        fi
    done

    run sudo pacman -Syu "${PACMAN_FLAGS[@]}" "${pkgs[@]}"
    ok "$(t "Paquets officiels Arch installés" "Official Arch packages installed")"
}

ensure_aur_helper() {
    if command -v yay >/dev/null 2>&1; then
        AUR_HELPER="yay"
        return
    fi
    if command -v paru >/dev/null 2>&1; then
        AUR_HELPER="paru"
        return
    fi
    step "$(t "Installation automatique de yay-bin (assistant AUR)" "Installing yay-bin automatically (AUR helper)")"
    if (( DRY_RUN )); then
        printf "  [dry-run] clone + makepkg -si yay-bin\n"
        AUR_HELPER="yay"
        return
    fi
    local tmp aur_pkg="yay-bin"
    tmp="$(mktemp -d)"
    if git clone --depth 1 "https://aur.archlinux.org/${aur_pkg}.git" "$tmp/$aur_pkg" \
        && (cd "$tmp/$aur_pkg" && makepkg -si --noconfirm); then
        rm -rf "$tmp"
        AUR_HELPER="yay"
        ok "$(t "yay-bin installé" "yay-bin installed")"
        return
    fi
    rm -rf "$tmp"
    tmp="$(mktemp -d)"
    git clone --depth 1 https://aur.archlinux.org/yay.git "$tmp/yay"
    (cd "$tmp/yay" && makepkg -si --noconfirm)
    rm -rf "$tmp"
    AUR_HELPER="yay"
    ok "$(t "yay installé" "yay installed")"
}

quickshell_qt_mismatch() {
    command -v qs >/dev/null 2>&1 || return 1
    local qt_sys qbin qt_built
    qt_sys="$(pacman -Q qt6-base 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
    qbin="$(command -v quickshell || command -v qs)"
    qt_built="$(strings "$qbin" 2>/dev/null | grep -oE '/QtCore/[0-9]+\.[0-9]+\.[0-9]+/QtCore/private' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
    [[ -n "$qt_sys" && -n "$qt_built" && "$qt_sys" != "$qt_built" ]]
}

install_aur_packages() {
    ensure_aur_helper
    step "$(t \
        "Installation des paquets AUR complémentaires (Material You, Darkly, QtEngine, polices)" \
        "Installing companion AUR packages (Material You, Darkly, QtEngine, fonts)")"
    local aur_flags=(--needed)
    (( YES )) && aur_flags+=(--noconfirm)

    # Quickshell (if absent from official repos, or rebuild if Qt6 ABI mismatch on quickshell-git)
    if ! command -v qs >/dev/null 2>&1; then
        run "$AUR_HELPER" -S "${aur_flags[@]}" quickshell-git
    elif ! (( DRY_RUN )) && quickshell_qt_mismatch && pacman -Q quickshell-git >/dev/null 2>&1; then
        warn "$(t \
            "Désalignement Qt6 détecté sur quickshell-git : recompilation automatique" \
            "Qt6 ABI mismatch detected on quickshell-git: rebuilding automatically")"
        run "$AUR_HELPER" -S --rebuild "${aur_flags[@]}" quickshell-git
    fi

    # Material You (with pip fallback if AUR build fails)
    if ! pacman -Q python-materialyoucolor >/dev/null 2>&1; then
        if ! run "$AUR_HELPER" -S "${aur_flags[@]}" python-materialyoucolor; then
            warn "$(t \
                "Échec AUR pour python-materialyoucolor, repli via pip utilisateur" \
                "AUR failed for python-materialyoucolor, falling back to user pip")"
            if ! python3 -c "import materialyoucolor" >/dev/null 2>&1; then
                run python3 -m pip install --user --break-system-packages materialyoucolor || true
            fi
        fi
    fi

    # Optional packages (avoiding conflicts with installed variants)
    if ! pacman -Q darkly-bin >/dev/null 2>&1 && ! pacman -Q darkly >/dev/null 2>&1; then
        run "$AUR_HELPER" -S "${aur_flags[@]}" darkly-bin || warn "$(t "Paquet AUR optionnel ignoré : darkly-bin" "Optional AUR package skipped: darkly-bin")"
    fi
    if ! pacman -Q qtengine >/dev/null 2>&1 && ! pacman -Q qtengine-git >/dev/null 2>&1; then
        run "$AUR_HELPER" -S "${aur_flags[@]}" qtengine || warn "$(t "Paquet AUR optionnel ignoré : qtengine" "Optional AUR package skipped: qtengine")"
    fi
    for pkg in gpu-screen-recorder ttf-material-symbols-variable ttf-rubik-vf; do
        if ! pacman -Q "$pkg" >/dev/null 2>&1; then
            run "$AUR_HELPER" -S "${aur_flags[@]}" "$pkg" || warn "$(t "Paquet AUR optionnel ignoré : $pkg" "Optional AUR package skipped: $pkg")"
        fi
    done
    ok "$(t "Paquets AUR traités" "AUR packages processed")"
}

build_cpp_plugins() {
    if (( NO_BUILD )); then
        return
    fi
    if [[ -d /usr/lib/qt6/qml/AnoShell ]] && [[ -f /usr/lib/qt6/qml/AnoShell/Shapes/qmldir ]] && (( ! REBUILD )); then
        ok "$(t \
            "Plugins C++ AnoShell.* et AnoShell.Shapes déjà installés (utilisez --rebuild pour recompiler)" \
            "Native C++ plugins AnoShell.* and AnoShell.Shapes already installed (use --rebuild to recompile)")"
        return
    fi
    step "$(t \
        "Compilation et installation des plugins C++ natifs (AnoShell.* + AnoShell.Shapes + shaders)" \
        "Building and installing native C++ plugins (AnoShell.* + AnoShell.Shapes + shaders)")"
    run cmake -B "$ROOT/build" -S "$ROOT" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc
    run cmake --build "$ROOT/build"
    run sudo cmake --install "$ROOT/build"

    if [[ -f "$ROOT/packaging/pacman/ano-shell-qt-check.hook" ]]; then
        run sudo install -Dm644 "$ROOT/packaging/pacman/ano-shell-qt-check.hook" \
            /usr/share/libalpm/hooks/ano-shell-qt-check.hook
    fi
    ok "$(t \
        "Plugins C++ et shaders installés dans /usr/lib/qt6/qml/AnoShell" \
        "C++ plugins and shaders installed in /usr/lib/qt6/qml/AnoShell")"
}

install_cursor() {
    step "$(t "Installation du curseur macOS (apple_cursor)" "Installing macOS cursor theme (apple_cursor)")"
    local dest="$HOME/.local/share/icons/macOS"
    if [[ -d "$dest/cursors" ]]; then
        ok "$(t "Curseur macOS déjà présent" "macOS cursor already installed")"
        return
    fi
    if (( DRY_RUN )); then
        printf "  [dry-run] %s apple_cursor v2.0.1 -> %s\n" "$(t "télécharge" "download")" "$dest"
        return
    fi
    local tmp
    tmp="$(mktemp -d)"
    if curl -sfL -o "$tmp/macOS.tar.xz" "https://github.com/ful1e5/apple_cursor/releases/download/v2.0.1/macOS.tar.xz" \
        && tar -xJf "$tmp/macOS.tar.xz" -C "$tmp" 2>/dev/null; then
        mkdir -p "$HOME/.local/share/icons" "$HOME/.icons/default"
        rm -rf "$dest"
        cp -r "$tmp/macOS" "$dest"
        printf '[Icon Theme]\nInherits=macOS\n' > "$HOME/.icons/default/index.theme"
        run_gsettings set org.gnome.desktop.interface cursor-theme 'macOS'
        ok "$(t "Curseur macOS installé" "macOS cursor installed")"
    else
        warn "$(t \
            "Téléchargement du curseur impossible (hors ligne ?) : curseur par défaut conservé." \
            "Could not download cursor (offline?): keeping default cursor.")"
    fi
    rm -rf "$tmp"
}

detect_kb_layout() {
    local km=""
    if [[ -f /etc/vconsole.conf ]]; then
        km="$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf | tr -d '"' | head -n1 || true)"
    fi
    if [[ -z "$km" ]] && command -v localectl >/dev/null 2>&1; then
        km="$(localectl status 2>/dev/null | sed -n 's/.*X11 Layout:[[:space:]]*//p' | head -n1 || true)"
        if [[ -n "$km" && "$km" != "n/a" ]]; then
            printf '%s\n' "${km%%,*}"
            return
        fi
        km="$(localectl status 2>/dev/null | sed -n 's/.*VC Keymap:[[:space:]]*//p' | head -n1 || true)"
    fi
    case "${km,,}" in
        fr*) echo "fr" ;;
        be*) echo "be" ;;
        ch*) echo "ch" ;;
        ca*) echo "ca" ;;
        de*) echo "de" ;;
        es*) echo "es" ;;
        it*) echo "it" ;;
        pt*) echo "pt" ;;
        uk*|gb*) echo "gb" ;;
        us*) echo "us" ;;
        *)
            if [[ "$UI_LANG" == "fr" ]]; then
                echo "fr"
            else
                echo "us"
            fi
            ;;
    esac
}

run_gsettings() {
    command -v gsettings >/dev/null 2>&1 || return 0
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        run gsettings "$@" 2>/dev/null || true
    elif command -v dbus-run-session >/dev/null 2>&1; then
        run dbus-run-session -- gsettings "$@" 2>/dev/null || true
    fi
}

install_qtengine_config() {
    local dst="$HOME/.config/qtengine/config.json"
    if [[ -f "$dst" ]]; then
        return
    fi
    if (( DRY_RUN )); then
        printf "  [dry-run] %s %s (Darkly + ano-shell.colors)\n" "$(t "configure" "configure")" "$dst"
        return
    fi
    mkdir -p "$(dirname "$dst")"
    cat > "$dst" <<EOF
{
    "theme": {
        "colorScheme": "$HOME/.config/qtengine/ano-shell.colors",
        "iconTheme": "Papirus-Dark",
        "style": "Darkly"
    }
}
EOF
    ok "$(t "Configuration qtengine (style Darkly) créée" "qtengine config (Darkly style) created")"
}

write_language_config() {
    local dst="$HOME/.config/ano-shell/lang.json"
    local val="${LANG_ARG:-auto}"
    if [[ "$val" != "fr" && "$val" != "en" && "$val" != "auto" ]]; then
        val="auto"
    fi
    if (( DRY_RUN )); then
        printf "  [dry-run] %s %s (lang=%s)\n" "$(t "écrit" "write")" "$dst" "$val"
        return
    fi
    mkdir -p "$(dirname "$dst")"
    cat > "$dst" <<EOF
{
    "lang": "$val"
}
EOF
    ok "$(t \
        "Langue configurée : $val (modifiable dans Paramètres → Langue et région)" \
        "Language configured: $val (changeable anytime in Settings → Language & region)")"
}

# ============================================================================
#  Main program
# ============================================================================

choose_language

step "$(t "Vérification de l'environnement" "Checking environment")"
if [[ $EUID -eq 0 ]]; then
    echo "$(t \
        "Ne lancez pas ./install en root : utilisez votre compte utilisateur normal." \
        "Do not run ./install as root: use your regular user account.")" >&2
    exit 1
fi

if (( FULL && ! NO_DEPS )); then
    install_system_packages
    install_aur_packages
fi

if (( ! NO_DEPS )); then
    build_cpp_plugins

    step "$(t "Installation de la CLI autonome ano-shell" "Installing standalone ano-shell CLI")"
    if command -v pip >/dev/null 2>&1 || python3 -m pip --version >/dev/null 2>&1; then
        run python3 -m pip install --user --break-system-packages --no-build-isolation --no-deps "$ROOT/cli"
        ok "$(t "CLI ano-shell installée (~/.local/bin/ano-shell)" "ano-shell CLI installed (~/.local/bin/ano-shell)")"
    else
        warn "$(t \
            "pip absent : installez le paquet AUR ano-shell ou python-pip." \
            "pip missing: install the ano-shell AUR package or python-pip.")"
    fi
fi

step "$(t "Installation du shell QML, des outils et d'Onde CLI" "Installing QML shell, tools and Onde CLI")"
if [[ -d "$ROOT/shell" ]]; then
    install_item "shell" "$HOME/.config/quickshell/ano-shell"
    ok "$(t "Shell QML installé dans ~/.config/quickshell/ano-shell" "QML shell installed in ~/.config/quickshell/ano-shell")"
elif [[ -d /etc/xdg/quickshell/ano-shell ]]; then
    install_path "/etc/xdg/quickshell/ano-shell" "$HOME/.config/quickshell/ano-shell" "/etc/xdg/quickshell/ano-shell"
    ok "$(t "Shell QML installé depuis le paquet système" "QML shell installed from system package")"
else
    warn "$(t "Dossier shell QML introuvable." "QML shell directory not found.")"
fi

run mkdir -p "$HOME/.local/bin"
for tool in "$ROOT/bin/"*; do
    [[ -f "$tool" ]] || continue
    name="$(basename "$tool")"
    run install -Dm755 "$tool" "$HOME/.local/bin/$name"
done
ok "$(t "Outils Ano Shell installés dans ~/.local/bin/" "Ano Shell tools installed in ~/.local/bin/")"

ONDE_SRC=""
if [[ -d "$ROOT/extras/onde-cli" ]]; then
    ONDE_SRC="$ROOT/extras/onde-cli"
elif [[ -d "$ROOT/onde-cli" ]]; then
    ONDE_SRC="$ROOT/onde-cli"
fi
if [[ -n "$ONDE_SRC" ]]; then
    install_path "$ONDE_SRC" "$HOME/.local/share/ano-shell/onde-cli" "onde-cli"
    run ln -sf "$HOME/.local/share/ano-shell/onde-cli/onde-cli" "$HOME/.local/bin/onde-cli"
    ok "$(t \
        "Onde CLI (lecteur musique terminal + paroles synchronisées) installé (~/.local/bin/onde-cli)" \
        "Onde CLI (terminal music player + synced lyrics) installed (~/.local/bin/onde-cli)")"
fi

if [[ -f "$ROOT/cli/ano_shell/data/emojis.txt" ]]; then
    run install -Dm644 "$ROOT/cli/ano_shell/data/emojis.txt" "$HOME/.local/share/ano-shell/emojis.txt"
elif [[ -f "$ROOT/emojis.txt" ]]; then
    run install -Dm644 "$ROOT/emojis.txt" "$HOME/.local/share/ano-shell/emojis.txt"
fi

# Make ano-shell and onde-cli accessible everywhere (including root pacman hooks and SDDM/sh)
if [[ -x "$HOME/.local/bin/ano-shell" ]] && [[ ! -x /usr/bin/ano-shell ]] && [[ ! -e /usr/local/bin/ano-shell || -L /usr/local/bin/ano-shell ]]; then
    run sudo install -d /usr/local/bin
