# Choose Liquid Glass performance profile (dedicated GPU vs laptop/iGPU)
choose_performance_profile() {
    local gpu dedicated=0 has_bat=0 cores
    gpu="$(t "GPU intégré" "Integrated GPU")"
    cores=$(nproc 2>/dev/null || echo 2)
    for vf in /sys/class/drm/card*/device/vendor; do
        [[ -r "$vf" ]] || continue
        case "$(tr '[:upper:]' '[:lower:]' < "$vf")" in
            0x10de) gpu="$(t "NVIDIA dédié" "Dedicated NVIDIA")"; dedicated=1; break ;;
            0x1002) gpu="AMD Radeon"; dedicated=1 ;;
            0x8086) [[ $dedicated -eq 0 ]] && gpu="Intel iGPU" ;;
        esac
    done
    for tf in /sys/class/power_supply/*/type; do
        [[ -r "$tf" ]] && [[ "$(cat "$tf")" == "Battery" ]] && { has_bat=1; break; }
    done

    local rec_num=1 rec_key="ultra"
    if (( ! dedicated )) && (( cores <= 4 || has_bat )); then
        rec_num=2
        rec_key="eco"
    fi

    local chosen="$PERF_PROFILE"
    if [[ -z "$chosen" ]]; then
        local desc="$gpu · ${cores} threads"
        if (( has_bat )); then
            desc+=" · $(t "portable" "laptop")"
        else
            desc+=" · $(t "secteur" "desktop")"
        fi
        printf "  %s : %s (%s : %s)\n" \
            "$(t "Matériel détecté" "Detected hardware")" "$desc" \
            "$(t "recommandé" "recommended")" "$rec_num"
        if [[ "$UI_LANG" == "fr" ]]; then
            printf "    ${B}1)${R} Puissance maximale (${C}ultra${R})   — PC puissant / GPU dédié : shader haute précision, panneaux préchargés\n"
            printf "    ${B}2)${R} Fluide & Autonomie (${C}eco${R})     — même rendu Liquid Glass, shader GPU ×2 plus léger, panneaux à la demande\n"
            printf "    ${B}3)${R} Automatique (${C}auto${R})           — pleine précision sur secteur, optimisé automatiquement sur batterie\n"
        else
            printf "    ${B}1)${R} Maximum quality (${C}ultra${R})      — Dedicated GPU / desktop: full-precision shader, preloaded panels\n"
            printf "    ${B}2)${R} Fluid & Battery (${C}eco${R})        — Same Liquid Glass look, 2× lighter GPU shader, lazy-loaded panels\n"
            printf "    ${B}3)${R} Automatic (${C}auto${R})             — Full precision on AC power, automatically optimized on battery\n"
        fi
        if (( YES || DRY_RUN )) || [[ ! -t 0 ]]; then
            chosen="$rec_key"
        else
            local ans=""
            read -r -p "  $(t "Quel profil appliquer ?" "Which profile to apply?") [${rec_num}] " ans || true
            case "${ans:-$rec_num}" in
                1|ultra|u|U) chosen="ultra" ;;
                2|eco|e|E) chosen="eco" ;;
                3|auto|a|A) chosen="auto" ;;
                *) chosen="$rec_key" ;;
            esac
        fi
    fi

    if [[ ! -f "$HOME/.config/ano-shell/glass.json" ]]; then
        run "$CLI_BIN" glass --auto --performance "$chosen"
    else
        run "$CLI_BIN" glass --performance "$chosen"
    fi
    ok "$(t \
        "Profil Liquid Glass configuré : $chosen (modifiable dans Paramètres → Fond d'écran et style)" \
        "Liquid Glass profile set: $chosen (changeable in Settings → Wallpaper & style)")"
}
choose_performance_profile

if [[ ! -e "$HOME/.local/state/ano-shell/wallpaper/current" ]] && [[ -f "$HOME/.config/quickshell/ano-shell/assets/wallpaper.webp" ]]; then
    if [[ -z "$(ls -A "$PICTURES_DIR/Wallpapers" 2>/dev/null || true)" ]]; then
        run cp -n "$HOME/.config/quickshell/ano-shell/assets/wallpaper.webp" "$PICTURES_DIR/Wallpapers/default.webp" 2>/dev/null || true
    fi
    run "$CLI_BIN" wallpaper -f "$HOME/.config/quickshell/ano-shell/assets/wallpaper.webp" || true
fi
