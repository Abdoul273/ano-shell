pkgver=1.2.0
pkgrel=1
pkgdesc='Standalone Liquid Glass desktop shell for Hyprland (Quickshell + native Qt6 C++ plugins + CLI + Onde CLI)'
arch=('x86_64' 'aarch64')
url='https://github.com/Abdoul273/ano-shell'
license=('GPL-3.0-only')
depends=(
    'quickshell'
    'hyprland'
    'xdg-desktop-portal'
    'xdg-desktop-portal-hyprland'
    'xdg-desktop-portal-gtk'
    'polkit-gnome'
    'gnome-keyring'
    'qt6-base'
    'qt6-declarative'
    'qt6-wayland'
    'qt6-svg'
    'qt6-imageformats'
    'qt6-multimedia'
    'qt6-multimedia-ffmpeg'
    'qt6-quick3d'
    'pipewire'
    'pipewire-pulse'
    'pipewire-alsa'
    'wireplumber'
    'bluez'
    'bluez-utils'
    'fftw'
    'libpipewire'
    'libqalculate'
    'lm_sensors'
    'networkmanager'
    'upower'
    'brightnessctl'
    'ddcutil'
    'hyprsunset'
    'gpu-screen-recorder'
    'adw-gtk-theme'
    'sound-theme-freedesktop'
    'gtk4'
    'python'
    'python-gobject'
    'python-pillow'
    'python-materialyoucolor'
    'python-rich'
    'python-mutagen'
    'python-numpy'
    'python-scipy'
    'python-flask'
    'python-webrtcvad'
    'mpv'
    'ffmpeg'
    'yt-dlp'
    'grim'
    'slurp'
    'wl-clipboard'
    'cliphist'
    'swappy'
    'wtype'
    'ydotool'
    'libnotify'
    'dconf'
    'jq'
    'psmisc'
    'libxml2'
    'ttf-material-symbols-variable'
    'ttf-cascadia-code-nerd'
    'ttf-jetbrains-mono-nerd'
    'bash'
)
optdepends=(
    'power-profiles-daemon: power profile switching'
    'nautilus: Liquid Glass file manager'
    'sushi: macOS-like Quick Look preview in Nautilus'
    'kitty: Liquid Glass terminal & quick-access dropdown'
    'fastfetch: styled system info'
    'fish: configured interactive shell'
    'starship: minimal transient prompt'
    'eza: modern ls with icons'
    'zoxide: smart cd'
    'btop: terminal system monitor'
    'darkly-bin: native translucent glass rendering for Qt/KDE apps'
    'qtengine: dynamic Qt6 color theme integration'
    'ttf-rubik-vf: rounded UI font for SDDM and glass tools'
    'sddm: Liquid Glass login screen'
    'accountsservice: user avatar sync for SDDM'
    'fprintd: fingerprint unlock on lock screen'
    'python-google-genai: Gemini AI support for Siri, Dictate and Write'
)
makedepends=(
    'cmake'
    'ninja'
    'git'
    'qt6-shadertools'
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DVERSION="${pkgver}" \
        -DGIT_REVISION="v${pkgver}" \
        -DDISTRIBUTOR="AUR (${pkgname})"
    cmake --build build

    python -m build --wheel --no-isolation cli
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    DESTDIR="${pkgdir}" cmake --install build
    python -m installer --destdir="${pkgdir}" cli/dist/*.whl

    install -d "${pkgdir}/usr/share/ano-shell"
    cp -a bin config extras/onde-cli install uninstall "${pkgdir}/usr/share/ano-shell/"
    if [[ -f cli/ano_shell/data/emojis.txt ]]; then
        install -Dm644 cli/ano_shell/data/emojis.txt "${pkgdir}/usr/share/ano-shell/emojis.txt"
    fi
    install -d "${pkgdir}/usr/bin"
    ln -s /usr/share/ano-shell/onde-cli/onde-cli "${pkgdir}/usr/bin/onde-cli"
    for tool in "${pkgdir}/usr/share/ano-shell/bin/"*; do
        [[ -f "$tool" ]] || continue
        name="$(basename "$tool")"
        [[ "$name" == "swappy" ]] && continue
        ln -s "/usr/share/ano-shell/bin/${name}" "${pkgdir}/usr/bin/${name}"
    done

    install -Dm644 packaging/pacman/ano-shell-qt-check.hook \
        "${pkgdir}/usr/share/libalpm/hooks/ano-shell-qt-check.hook"

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
}
