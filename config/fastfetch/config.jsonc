{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "@HOME@/.config/fastfetch/logo.png",
        "type": "kitty-direct",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": {
            "keys": "cyan",
            "title": "magenta"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "    {user-name-colored} 󰄾 {host-name-colored}"
        },
        {
            "type": "custom",
            "format": "  ───────────────────────────────────"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "   Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "   Shell",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "  ───────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        },
        "break"
    ]
}
